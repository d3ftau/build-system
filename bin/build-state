#!/usr/bin/env python3
"""build-state — where a project has got to, and what runs next.

Every branch here is a function of files on disk. There is nothing fuzzy in
this decision, so there is no model in it.
"""

from __future__ import annotations

import json
import re
import subprocess
import sys
from dataclasses import dataclass, field
from pathlib import Path

# Artifacts in pipeline order. Used to find the furthest one reached.
PIPELINE = ["BRIEF.md", "EXPLORE.md", "DESIGN.md", "SPEC.md", "PLAN.md"]

CHECKBOX = re.compile(r"^\s*[-*]\s*\[([ xX])\]\s*(.+?)\s*$", re.MULTILINE)


class Style:
    def __init__(self, enabled: bool):
        self.enabled = enabled

    def _wrap(self, code: str, text: str) -> str:
        return f"\033[{code}m{text}\033[0m" if self.enabled else text

    def bold(self, text: str) -> str:
        return self._wrap("1", text)

    def dim(self, text: str) -> str:
        return self._wrap("2", text)


@dataclass
class Report:
    headline: str
    stage: str = ""
    detail: list[str] = field(default_factory=list)
    command: str | None = None
    command_note: str | None = None
    warnings: list[str] = field(default_factory=list)


def read(root: Path, name: str) -> str | None:
    path = root / name
    try:
        return path.read_text(encoding="utf-8")
    except (FileNotFoundError, NotADirectoryError):
        return None


# A BLOCKED section opens on a heading ("## BLOCKED", "### BLOCKED (…)") or a bold-only line
# ("**BLOCKED — check before …**"). Its items are list entries ("- …", "1. …") or, under a
# "##" heading, "###" sub-headings. Formats as found in real EXPLORE.md files, 2026-10-05.
BLOCKED_OPEN = re.compile(r"^(#{2,4})\s+BLOCKED\b|^\*\*BLOCKED\b.*\*\*\s*$")
SECTION_END = re.compile(r"^(#{1,4})\s|^\*\*[^*].*\*\*\s*$|^---")
LIST_ITEM = re.compile(r"^(?:[-*]|\d+\.)\s+(.+)$")
SECTION_CLEARED = re.compile(r"\bnone outstanding\b|\bno blocked items remain\b", re.I)
ITEM_SETTLED = re.compile(r"\b(moot|resolved|void|deferred|not blocking|answered)\b|^~~|^none\b", re.I)


def blocked_items(explore: str) -> list[str]:
    """Open items in EXPLORE.md's BLOCKED section(s).

    Section headings are not items. A section saying "None outstanding" or "No
    BLOCKED items remain" has none, and an item whose own title says it is
    moot, resolved, void, deferred or not blocking is settled, not open.
    """
    items: list[str] = []
    lines = explore.splitlines()
    i = 0
    while i < len(lines):
        m = BLOCKED_OPEN.match(lines[i])
        if not m:
            i += 1
            continue
        level = len(m.group(1)) if m.group(1) else 99
        section: list[str] = []
        i += 1
        while i < len(lines):
            line = lines[i]
            h = re.match(r"^(#{1,4})\s+(.+)$", line)
            if h and len(h.group(1)) > level:  # a sub-heading under "## BLOCKED" is an item
                section.append(h.group(2))
            elif SECTION_END.match(line):
                break
            elif (li := LIST_ITEM.match(line)):
                section.append(li.group(1))
            elif SECTION_CLEARED.search(line):
                section = ["__cleared__"]
            i += 1
        if section == ["__cleared__"] or any(SECTION_CLEARED.search(s) for s in section):
            continue
        for raw in section:
            text = re.sub(r"[*`]", "", raw).strip()
            # Judge an item by its title: the bold lead if it has one, else its opening words,
            # so a long explanation that mentions "resolved" in passing doesn't settle it.
            bold = re.match(r"^\*\*(.+?)\*\*", raw)
            title = bold.group(1) if bold else text[:120]
            if text and not ITEM_SETTLED.search(title):
                items.append(text)
    return items


# Older plans (before /plan required checkboxes, 2026-10-01) mark tasks as headings:
#   ### Task 4 — Schema ✅ done
TASK_HEADING = re.compile(r"^#{2,4}\s+(Task\s+\S+?\s*[—–-].*?)\s*$")
PHASE_HEADING = re.compile(r"^##\s+(.+?)\s*$")


def _clean(text: str) -> str:
    return re.sub(r"\*\*|`", "", text).strip()


def plan_tasks(plan: str) -> list[dict]:
    """Every task and checkpoint line in PLAN.md, in order, from either format.

    Checkbox: done is the box. Heading: done is a ✅ in the heading, and the
    words after it are the done note ("RUN, FAILED AS DESIGNED").
    """
    tasks: list[dict] = []
    phase = ""
    for line in plan.splitlines():
        if (m := PHASE_HEADING.match(line)):
            phase = _clean(m.group(1))
            continue
        if (m := CHECKBOX.match(line)):
            title = _clean(m.group(2))
            note = ""
            if (n := re.search(r"\s*\*?\((.+?)\)\*?\s*$", title)):
                note, title = n.group(1).strip("* "), title[: n.start()].strip()
            tasks.append({"phase": phase, "title": title.rstrip("."), "done": m.group(1).lower() == "x",
                          "note": note, "checkpoint": title.lstrip("→ ").startswith("/checkpoint")})
            continue
        if (m := TASK_HEADING.match(line)):
            text = _clean(m.group(1))
            title, mark, note = text.partition("✅")
            tasks.append({"phase": phase, "title": title.rstrip(" —–-"), "done": bool(mark),
                          "note": note.strip(" —–-"), "checkpoint": False})
    return tasks


def plan_progress(plan: str) -> tuple[int, int, str | None]:
    tasks = plan_tasks(plan)
    done = sum(1 for t in tasks if t["done"])
    nxt = next((t["title"] for t in tasks if not t["done"]), None)
    return done, len(tasks), nxt


# SPEC.md requirements: "- [x] **FR-3 — Short feature name.** WHEN ..." (the name is optional;
# older specs have only "- [x] **FR-3** — WHEN ..."). Struck-through or REMOVED ones are dropped.
FR_LINE = re.compile(r"^\s*[-*]\s*\[([ xX])\]\s*(~~)?\s*\*\*(FR-\d+)\s*(?:[—–-]+\s*(.*?))?\*\*(.*)$")


def features(spec: str) -> list[dict]:
    out = []
    for line in spec.splitlines():
        m = FR_LINE.match(line)
        if not m or m.group(2) or "REMOVED" in line:
            continue
        name = _clean(m.group(4) or "").rstrip(".")
        if name.upper().startswith("WHEN"):
            name = ""
        out.append({"id": m.group(3), "name": name, "done": m.group(1).lower() == "x"})
    return out


# ROADMAP.md builds: "### Build 2 — The magic helper" or, inside "## Builds, in order",
# "**2. Remaining source breadth — ...**". An optional "Feature: <short name>" line under a
# build gives it a feature-level name.
BUILD_HEADING = re.compile(r"^###\s+Build\s+(\d+)\s*[—–:-]+\s*(.+?)\s*$")
BUILD_BOLD = re.compile(r"^\*\*(\d+)\.\s+(.+?)\*\*\s*$")
FEATURE_LINE = re.compile(r"^\s*\*{0,2}Feature:\*{0,2}\s*(.+?)\s*$")


def roadmap_builds(roadmap: str) -> list[dict]:
    builds: list[dict] = []
    in_builds = False
    for line in roadmap.splitlines():
        if line.startswith("## "):
            in_builds = "build" in line.lower()
        m = BUILD_HEADING.match(line) or (in_builds and BUILD_BOLD.match(line))
        if m:
            builds.append({"n": int(m.group(1)), "name": _clean(m.group(2)), "feature": ""})
        elif builds and (f := FEATURE_LINE.match(line)) and not builds[-1]["feature"]:
            builds[-1]["feature"] = _clean(f.group(1))
    return builds


def current_build(*docs: str | None) -> int | None:
    """The build number named in the first line of BRIEF.md or PLAN.md ("PLAN — Build 1: ...")."""
    for doc in docs:
        if doc and doc.strip() and (m := re.search(r"\bBuild\s+(\d+)\b", doc.splitlines()[0])):
            return int(m.group(1))
    return None


def committed(root: Path, name: str) -> bool:
    """True once the file has at least one commit (later edits, like ticks, don't matter)."""
    try:
        r = subprocess.run(["git", "log", "-1", "--format=%h", "--", name], cwd=root,
                           capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return False
    return r.returncode == 0 and bool(r.stdout.strip())


def scaffold_present(root: Path) -> bool:
    return (root / "Makefile").exists() or (root / "src").is_dir()


def git_state(root: Path, name: str) -> str | None:
    """Return a warning if the artifact is uncommitted, else None."""
    def git(*argv: str) -> subprocess.CompletedProcess[str]:
        return subprocess.run(
            ["git", *argv], cwd=root, capture_output=True, text=True, timeout=5
        )

    try:
        inside = git("rev-parse", "--is-inside-work-tree")
        if inside.returncode != 0:
            return None  # not a git repo; nothing to say
        # Fails with no commits yet, which still means "never committed".
        tracked = git("log", "-1", "--format=%h", "--", name)
        dirty = git("status", "--porcelain", "--", name)
    except (OSError, subprocess.SubprocessError):
        return None

    if not tracked.stdout.strip():
        return f"{name} has never been committed. Commit it before moving on."
    if dirty.stdout.strip():
        return f"{name} has uncommitted changes. Commit them before moving on."
    return None


def project_root(root: Path) -> Path:
    """The git top level (a per-build docs folder like builds/build-2 belongs to its project)."""
    try:
        r = subprocess.run(["git", "rev-parse", "--show-toplevel"], cwd=root,
                           capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return root
    return Path(r.stdout.strip()) if r.returncode == 0 and r.stdout.strip() else root


COMPOSE_FILES = ["docker-compose.yml", "docker-compose.yaml", "compose.yml", "compose.yaml"]
UNIT_DIRS = [Path("/etc/systemd/system"), Path.home() / ".config" / "systemd" / "user"]
PAGES_ACTIONS = re.compile(r"actions/deploy-pages@|peaceiris/actions-gh-pages@|JamesIves/github-pages-deploy-action@")


def mentions(text: str, project: Path) -> bool:
    """Text names a path inside the project, written absolute, %h/ (systemd), ~/ or $HOME/."""
    home = str(Path.home())
    rel = str(project)[len(home) + 1:] if str(project).startswith(home + "/") else None
    forms = [str(project)] + ([f"%h/{rel}", f"~/{rel}", f"$HOME/{rel}", f"${{HOME}}/{rel}"] if rel else [])
    return any(re.search(re.escape(f) + r"(?=[/\s'\";:]|$)", text, re.M) for f in forms)


def deployments(project: Path) -> list[str]:
    """Ways this project runs outside a dev session: a compose file, a systemd unit or a cron
    line that runs something from its folder, or a workflow that publishes GitHub Pages.
    Whether it is up right now is the dashboard's Live/Down, not this."""
    found = [n for n in COMPOSE_FILES if (project / n).exists()][:1]
    for d in UNIT_DIRS:
        for unit in sorted(d.glob("*.service")) if d.is_dir() else []:
            try:
                if mentions(unit.read_text(encoding="utf-8", errors="replace"), project):
                    found.append(f"systemd {unit.name}")
            except OSError:
                pass
    try:
        cron = subprocess.run(["crontab", "-l"], capture_output=True, text=True, timeout=5)
        if cron.returncode == 0 and any(mentions(l, project) for l in cron.stdout.splitlines()
                                        if l.strip() and not l.lstrip().startswith("#")):
            found.append("cron")
    except (OSError, subprocess.SubprocessError):
        pass
    for wf in sorted((project / ".github" / "workflows").glob("*.y*ml")):
        if PAGES_ACTIONS.search(wf.read_text(encoding="utf-8", errors="replace")):
            found.append("GitHub Pages")
            break
    return found


# A project outside the pipeline (no BRIEF … PLAN) keeps its to-do list as a checklist under a
# "## To do" heading in README.md. Same checkbox syntax as PLAN.md.
TODO_HEADING = re.compile(r"^#{2,3}\s+to[\s-]?do\b", re.I)


def readme_todo(readme: str) -> list[dict]:
    items: list[dict] = []
    inside = False
    for line in readme.splitlines():
        if re.match(r"^#{1,3}\s", line):
            inside = bool(TODO_HEADING.match(line))
            continue
        if inside and (m := CHECKBOX.match(line)):
            items.append({"title": _clean(m.group(2)).rstrip("."), "done": m.group(1).lower() == "x"})
    return items


def git_clean_and_pushed(project: Path) -> tuple[bool, str | None]:
    """(True, None), or (False, why): uncommitted changes, unpushed commits, or no upstream."""
    def git(*argv: str) -> subprocess.CompletedProcess[str]:
        return subprocess.run(["git", *argv], cwd=project, capture_output=True, text=True, timeout=5)
    try:
        if git("status", "--porcelain").stdout.strip():
            return False, "it has uncommitted changes"
        ahead = git("rev-list", "--count", "@{u}..HEAD")
    except (OSError, subprocess.SubprocessError):
        return False, "git couldn't be read"
    if ahead.returncode != 0:
        return False, "it isn't pushed anywhere (no upstream branch)"
    if ahead.stdout.strip() != "0":
        return False, f"{ahead.stdout.strip()} commit(s) aren't pushed"
    return True, None


def has_commits(project: Path) -> bool:
    try:
        r = subprocess.run(["git", "rev-parse", "--verify", "-q", "HEAD"], cwd=project,
                           capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return False
    return r.returncode == 0


def assess_quickie(root: Path) -> Report | None:
    """A project that skipped the pipeline entirely. None if there's nothing here yet.

    Shipped = every README to-do ticked (or no list), something deployed, git clean and
    pushed. Each of those can come undone, and the project drops back to in progress.
    """
    project = project_root(root)
    readme = read(project, "README.md")
    if readme is None and not has_commits(project):
        return None
    todo = readme_todo(readme or "")
    left = [t["title"] for t in todo if not t["done"]]
    deployed = deployments(project)
    clean, why = git_clean_and_pushed(project)
    if not left and deployed and clean:
        return Report(
            stage="done",
            headline="A quick project, built and running. No to-do items left.",
            detail=[f"Runs via: {', '.join(deployed)}."],
        )
    detail = []
    if todo:
        detail.append(f"{len(todo) - len(left)} of {len(todo)} to-do items done in README.md.")
        if left:
            detail.append(f"Next up: {left[0]}")
    else:
        detail.append("No '## To do' checklist in README.md, so there's nothing to measure progress by.")
    if not deployed:
        detail.append("Nothing runs it outside a dev session (no compose file, systemd unit, cron line or Pages workflow).")
    if not clean:
        detail.append(f"Not shipped while {why}.")
    return Report(stage="quickie", headline="A quick project, outside the build pipeline.", detail=detail)


def furthest_artifact(root: Path) -> str | None:
    return next((n for n in reversed(PIPELINE) if (root / n).exists()), None)


def agreed_warning(spec: str) -> str | None:
    agreed = spec.count("[AGREED]")
    stated = spec.count("[STATED]")
    if not agreed:
        return None
    line = (
        f"SPEC.md carries {agreed} [AGREED] requirement"
        f"{'s' if agreed != 1 else ''} against {stated} [STATED]."
    )
    if agreed > stated:
        line += (
            " More was proposed to you than you asked for — that's the"
            " cheapest scope to be wrong about."
        )
    else:
        line += " Those are the first things to cut if this comes back too big."
    return line


def assess(root: Path) -> Report:
    if (root / "PLAYBOOK.md").exists() and (root / "commands").is_dir():
        return Report(
            stage="build-system",
            headline="This is the build-system repo itself, not a project.",
            detail=["Run this from a project directory under ~/projects/ instead."],
        )

    # A step only gates when nothing after it exists. A project that went straight to a spec
    # (or a plan) skipped the earlier steps on purpose; asking for them now would be wrong.
    def later(*names: str) -> bool:
        return any((root / n).exists() for n in names)

    brief = read(root, "BRIEF.md")
    if brief is None and not later("EXPLORE.md", "DESIGN.md", "SPEC.md", "PLAN.md"):
        if not later("DISCOVERY.md", "ROADMAP.md") and (quick := assess_quickie(root)):
            return quick
        return Report(
            stage="not-started",
            headline="Nothing started here yet.",
            detail=[
                "There's no BRIEF.md, so the pipeline hasn't begun.",
                "If the idea is still half-formed, talk it through first."
                " If you can already describe 'done' in one sentence, go"
                " straight to the brief.",
            ],
            command="/discovery   — or /brief if 'done' is already clear",
        )

    explore = read(root, "EXPLORE.md")
    if explore is None and not later("DESIGN.md", "SPEC.md", "PLAN.md"):
        return Report(
            stage="explore",
            headline="The brief is written, but nothing has been checked against reality.",
            detail=[
                "What the candidate tools actually do hasn't been established,"
                " and design shouldn't start without it — that's how an option"
                " gets ruled out for a reason that stopped being true.",
            ],
            command="/explore",
        )

    blocked = blocked_items(explore) if explore else []
    design = read(root, "DESIGN.md")
    spec = read(root, "SPEC.md")

    # A blocker halts everything downstream, however far along the build is.
    if blocked:
        return Report(
            stage="blocked",
            headline=f"Blocked. {len(blocked)} open item{'s' if len(blocked) != 1 else ''} in EXPLORE.md.",
            detail=[
                "These are checkable and unchecked. Nothing downstream should"
                " proceed on a guess about them:",
                "\n".join(f"  · {item}" for item in blocked),
            ],
            command_note=(
                "Clear each one — either find the answer, or cut what depends"
                " on it and say what was cut."
            ),
        )

    if design is None and not later("SPEC.md", "PLAN.md"):
        return Report(
            stage="design",
            headline="Exploration is done and clear. Time to pick a shape.",
            detail=["EXPLORE.md has no open blockers, so design can start from what's actually true."],
            command="/design",
        )

    if spec is None and not later("PLAN.md"):
        return Report(
            stage="contract",
            headline="A design is chosen. Next is the contract.",
            detail=["This writes CLAUDE.md and SPEC.md — requirements and verification gates, no code."],
            command="/contract",
        )

    spec = spec or ""
    warnings = [w for w in [agreed_warning(spec)] if w]

    # Built = every SPEC requirement ticked; the plan's tasks only if the spec has none. When
    # all FRs are ticked the plan's own ticks have lagged (it was abandoned or rescoped), and
    # holding the project in the build loop over that would be wrong.
    plan = read(root, "PLAN.md")
    done, total, next_task = plan_progress(plan) if plan else (0, 0, None)
    feats = features(spec)
    built = all(f["done"] for f in feats) if feats else bool(total) and done == total
    if feats and built and total and done < total:
        warnings.append(f"Every FR in SPEC.md is ticked but PLAN.md has {total - done} unticked"
                        " task(s). Tick or strike them so the plan matches what was built.")

    assumed = spec.count("[ASSUMED]")
    if assumed and built:
        # Too late to keep them out of the plan, but each is still a decision never made.
        warnings.append(f"SPEC.md still has {assumed} [ASSUMED] tag{'s' if assumed != 1 else ''}"
                        " nobody ruled on. Run /audit in a fresh session to settle them.")
    elif assumed:
        return Report(
            stage="audit",
            headline=f"The spec has {assumed} unresolved [ASSUMED] tag{'s' if assumed != 1 else ''}.",
            detail=[
                "Each one is a gap a model filled and you never ruled on."
                " None should reach the plan.",
            ],
            command="/audit",
            command_note=(
                "Run this in a brand-new `claude` session in this directory,"
                " never the current one — continuing defeats the fresh-eyes read."
            ),
            warnings=warnings,
        )

    if plan is None and not built:
        return Report(
            stage="plan",
            headline="The spec is audited and clean. Ready to plan.",
            command="/plan",
            command_note="Restart with `claude --permission-mode plan` first — not just /plan in this session.",
            warnings=warnings,
        )

    project = project_root(root)
    deployed = deployments(project)

    if not built and not scaffold_present(root) and not scaffold_present(project):
        return Report(
            stage="scaffold",
            headline="The plan is written, but there's no scaffold yet.",
            detail=[
                "Directory structure, dependencies, a Makefile with a check"
                " target, and one failing placeholder test — verified running"
                " and committed before any business logic.",
            ],
            command_note="Scaffold first, then the first /slice.",
            warnings=warnings,
        )

    if not built and next_task and next_task.lstrip("→ ").startswith("/checkpoint"):
        return Report(
            stage="checkpoint",
            headline="A phase is finished. Check it before building on it.",
            detail=[
                f"{done} of {total} items done in PLAN.md. Every task in this"
                " phase passed its own gate — whether its output is good"
                " enough to build the next phase on is a different question.",
            ],
            command="/checkpoint",
            command_note=(
                "Run this in a brand-new `claude` session in this directory —"
                " a reader who didn't build it, not the session that did."
            ),
            warnings=warnings,
        )

    if not built:
        detail = [f"{done} of {total} tasks done in PLAN.md."] if total else []
        if feats:
            detail.append(f"{sum(f['done'] for f in feats)} of {len(feats)} requirements ticked in SPEC.md.")
        if next_task:
            detail.append(f"Next up: {next_task}")
        return Report(
            stage="build",
            headline="You're in the build loop.",
            detail=detail,
            command="/slice",
            warnings=warnings,
        )

    readme = (project / "README.md").exists() or (root / "README.md").exists()

    # Not everything needs deploying (a library, a CLI): a README written after the build counts
    # as the end. Only when there's neither is /deploy the next step.
    if not deployed and not readme:
        return Report(
            stage="deploy",
            headline="Everything in the spec is built. Nothing is deployed yet.",
            command="/deploy",
            command_note="If there's nothing to deploy, go straight to /complete.",
            warnings=warnings,
        )

    if not readme:
        return Report(
            stage="complete",
            headline="Built and deployed, but the docs haven't been brought up to date.",
            detail=[
                "CLAUDE.md and DESIGN.md were written before the build and"
                " nothing has revisited them since. There's no README.md.",
            ],
            command="/complete",
            command_note="Run this in the session that did the build — its memory of why things changed is the point.",
            warnings=warnings,
        )

    return Report(
        stage="done",
        headline=("This is built, deployed and documented." if deployed
                  else "This is built and documented; nothing is deployed.") + " No commands left to run.",
        detail=[
            *([f"Runs via: {', '.join(deployed)}."] if deployed else []),
            "What's left is operating it: backups for anything that can't be"
            " regenerated, and a kill date if it goes unused.",
        ],
        warnings=warnings,
    )


def render(report: Report, root: Path, style: Style) -> None:
    out = sys.stdout.write
    out("\n" + style.bold(report.headline) + "\n")

    for line in report.detail:
        out("\n" + line + "\n")

    if report.command:
        out("\n    " + style.bold(report.command) + "\n")
    if report.command_note:
        out("\n" + report.command_note + "\n")

    artifact = furthest_artifact(root)
    warnings = list(report.warnings)
    if artifact:
        git_warning = git_state(root, artifact)
        if git_warning:
            warnings.append(git_warning)

    for warning in warnings:
        out("\n" + style.dim("— " + warning) + "\n")

    out("\n")


def facts(report: Report, root: Path) -> dict:
    """Everything the human output says, plus the parsed docs, for other tools (the dashboard)."""
    plan, spec, explore = read(root, "PLAN.md"), read(root, "SPEC.md"), read(root, "EXPLORE.md")
    tasks = plan_tasks(plan) if plan else []
    artifact = furthest_artifact(root)
    warnings = list(report.warnings)
    if artifact and (w := git_state(root, artifact)):
        warnings.append(w)
    project = project_root(root)
    quickie = report.stage == "quickie" or (report.stage == "done" and artifact is None)
    present = [n for n in PIPELINE if (root / n).exists()]
    return {
        # "quickie" = outside the pipeline: progress comes from README.md's "## To do" list.
        "track": "quickie" if quickie else "pipeline",
        "todo": readme_todo(read(project, "README.md") or "") if quickie else [],
        "deployments": deployments(project),
        # Pipeline steps passed over: an earlier doc missing while a later one exists.
        "skipped": [n for i, n in enumerate(PIPELINE) if n not in present and any(p in present for p in PIPELINE[i + 1:])],
        "stage": report.stage,
        "headline": report.headline,
        "detail": report.detail,
        "command": report.command,
        "command_note": report.command_note,
        "warnings": warnings,
        "docs": [n for n in ["DISCOVERY.md", "ROADMAP.md", *PIPELINE] if (root / n).exists()],
        "plan_committed": plan is not None and committed(root, "PLAN.md"),
        "blocked": blocked_items(explore) if explore else [],
        "assumed": spec.count("[ASSUMED]") if spec else 0,
        "tasks": tasks,
        "done": sum(1 for t in tasks if t["done"]),
        "total": len(tasks),
        "features": features(spec) if spec else [],
        "builds": roadmap_builds(read(root, "ROADMAP.md") or ""),
        "current_build": current_build(read(root, "BRIEF.md"), plan),
    }


def main() -> int:
    args = sys.argv[1:]
    if args and args[0] in {"-h", "--help"}:
        print(__doc__.strip())
        print("\nusage: build-state [status] [--json] [path]")
        return 0
    as_json = "--json" in args
    args = [a for a in args if a != "--json"]
    if args and args[0] == "status":
        args = args[1:]

    root = Path(args[0]).resolve() if args else Path.cwd()
    if not root.is_dir():
        print(f"build-state: {root} is not a directory", file=sys.stderr)
        return 1

    report = assess(root)
    if as_json:
        print(json.dumps(facts(report, root), ensure_ascii=False))
    else:
        render(report, root, Style(sys.stdout.isatty()))
    return 0


if __name__ == "__main__":
    sys.exit(main())
